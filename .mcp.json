{
  "mcpServers": {
    "codex_image_grid": {
      "command": "./target/release/image-grid-mcp",
      "cwd": ".",
      "env": {
        "IMAGE_GRID_URL": "http://127.0.0.1:4322",
        "IMAGE_GRID_APP_DIR": ".",
        "IMAGE_GRID_START_COMMAND": "exec ./target/release/image-grid-server --bind 127.0.0.1:4322 --data-root \"$HOME/Library/Application Support/codex-image-grid-native\" --server-root \"$PWD\" --workspace-root \"$HOME/Library/Application Support/codex-image-grid-native\" --launch-target mcp",
        "IMAGE_GRID_STRICT_APP_DIR": "1",
        "IMAGE_GRID_LAUNCH_TIMEOUT_MS": "15000",
        "IMAGE_GRID_HEALTH_REQUEST_TIMEOUT_MS": "1000",
        "IMAGE_GRID_PREFLIGHT_TIMEOUT_MS": "20000",
        "IMAGE_GRID_RUN_REQUEST_TIMEOUT_MS": "150000"
      }
    }
  }
}
